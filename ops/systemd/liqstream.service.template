[Unit]
Description=Grid Gremlin v3 liquidation stream (D84) — Bybit's liquidations as they happen, public, kept in logs/collect/ seven days, nothing acts on them

[Service]
Type=simple
WorkingDirectory={{REPO_DIR}}
Nice=10
Restart=always
RestartSec=30
ExecStart=/usr/bin/python3 -m gridgremlin.liqstream

[Install]
WantedBy=default.target

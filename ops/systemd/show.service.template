[Unit]
Description=Grid Gremlin v3 show file (D86) — what the public showcase may say about the bots, by allowlist, written to logs/show/show.json

[Service]
Type=oneshot
WorkingDirectory={{REPO_DIR}}
EnvironmentFile={{REPO_DIR}}/.env
Nice=10
ExecStart=/usr/bin/python3 -m gridgremlin.show configs/{{FLEET_CONFIG}} {{MORE_FLEET_CONFIGS}}

[Unit]
Description=Grid Gremlin v3 show file — every 15 minutes

[Timer]
# :14/15 sits off the ledger (:27), logrotate (:52), the market (:33), the
# archive (23:56) and the digest (23:58); every minute is some watchdog's
# slot, and both are niced. Not Persistent: a missed write is a stale page,
# and the page says its age.
OnCalendar=*-*-* *:14/15:00

[Install]
WantedBy=timers.target

[Unit]
Description=Grid Gremlin v3 showcase (D86) — the public face: read-only, GET only, no keys, no controls; reads logs/show/show.json and the market reading

[Service]
Type=simple
WorkingDirectory={{REPO_DIR}}
# no EnvironmentFile: the showcase holds no key, not even a Telegram token
Nice=10
Restart=always
RestartSec=30
ExecStart=/usr/bin/python3 -m showcase.server --port 41950 --bind 127.0.0.1

[Install]
WantedBy=default.target

[Unit]
Description=Grid Gremlin v3 market report (D67) — a fresh reading, paged at each session's open

[Service]
Type=oneshot
WorkingDirectory={{REPO_DIR}}
EnvironmentFile={{REPO_DIR}}/.env
Nice=10
ExecStart=/usr/bin/python3 -m gridgremlin.market configs/{{FLEET_CONFIG}} {{MORE_FLEET_CONFIGS}} --send

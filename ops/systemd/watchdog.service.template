[Unit]
Description=Grid Gremlin v3 {{FLEET}} watchdog — snapshot staleness + per-bot bounds
OnFailure=grid-gremlin3-{{FLEET}}-watchdog-failed.service

[Service]
Type=oneshot
WorkingDirectory={{REPO_DIR}}
# F24c: names the fleet, so its run pings DEADMAN_URL_<FLEET> from .env
Environment=GG_FLEET={{FLEET}}
ExecStart=/usr/bin/python3 -m gridgremlin.watchdog configs/{{WATCHDOG_CONFIG}}
# exit 3 = breaches found AND PAGED by the watchdog itself — that is a success
# for the unit. Never 1: a crash (traceback, send failure) exits 1, and fails
# the unit, so OnFailure pages that nobody is watching.
SuccessExitStatus=3

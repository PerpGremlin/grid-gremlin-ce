[Unit]
Description=Grid Gremlin v3 {{FLEET}} fleet down — alert, at most one page per 30 min

[Service]
Type=oneshot
EnvironmentFile={{REPO_DIR}}/.env
# The stamp file rate-limits the page. Found live 2026-08-04: with
# StartLimitIntervalSec=0, EVERY failed restart re-triggers OnFailure — a
# venue outage became one Telegram page per retry, all night. First failure
# pages immediately; repeats are swallowed for 1800s. The bot token reaches
# curl through its config on stdin (`-K -`) from the shell's own printf, and
# `$$` leaves the expansion to the shell: in argv, any local user's `ps`
# showed it (audit 2026-10-05).
ExecStart=/bin/sh -c 'stamp={{REPO_DIR}}/logs/{{FLEET}}-failed.stamp; now=$$(date +%%s); last=$$(cat "$$stamp" 2>/dev/null || echo 0); [ $$((now - last)) -lt 1800 ] && exit 0; echo "$$now" > "$$stamp"; printf "url = https://api.telegram.org/bot%%s/sendMessage" "$${TELEGRAM_BOT_TOKEN}" | curl -s -m 20 -K - --data-urlencode chat_id="$${TELEGRAM_CHAT_ID}" --data-urlencode parse_mode=HTML --data-urlencode text="<b>{{LABEL}} v3 {{FLEET}}: the fleet is down</b> (page repeats at most every 30 min). See: journalctl --user -u grid-gremlin3-{{FLEET}} -n 200"'
# The page alone: the box-side diagnosis that followed it is retired
# (ops/retired/README.md) — the fleet-down page carries no diagnosis.

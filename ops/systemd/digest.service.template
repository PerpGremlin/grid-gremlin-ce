[Unit]
Description=Grid Gremlin v3 daily digest (F17, D62) — one message, read-only toward the venues

[Service]
Type=oneshot
WorkingDirectory={{REPO_DIR}}
EnvironmentFile={{REPO_DIR}}/.env
Nice=10
# a bound on the whole run: a venue that hangs never holds the digest past it
TimeoutStartSec=1800
# the ledger first, so the day is whole to the minute (R18)
ExecStartPre=/usr/bin/python3 -m gridgremlin.kept_fills configs/{{FLEET_CONFIG}} {{MORE_FLEET_CONFIGS}}
# then the ledger beside the venue's own record of the week (F39–F41):
# read-only; the leading '-' keeps a crash from costing the digest, which
# then says the report's age; ten minutes at most
ExecStartPre=-/usr/bin/timeout 600 /usr/bin/python3 -m gridgremlin.pnl_drift run configs/{{FLEET_CONFIG}} {{MORE_FLEET_CONFIGS}}
ExecStart=/usr/bin/python3 -m gridgremlin.digest configs/{{FLEET_CONFIG}} {{MORE_FLEET_CONFIGS}}

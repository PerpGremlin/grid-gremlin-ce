[Unit]
Description=Grid Gremlin v3 — {{DESC}}
After=network-online.target
Wants=network-online.target
# a fleet never runs unwatched (the audit, 2026-11-06: one fleet's watchdog
# timer sat inactive for two weeks): starting the fleet starts its watchdog
# timer; stopping the fleet leaves the timer, whose staleness page says so
Wants=grid-gremlin3-{{FLEET}}-watchdog.timer
OnFailure=grid-gremlin3-{{FLEET}}-failed.service
# Patient-retry fleets (a venue that 502s for hours, e.g. a testnet) set
# StartLimitIntervalSec=0 — the unit never gives up; the watchdog's staleness
# page is the alarm. Fleets that should stop crash-looping on a code defect
# keep a finite window instead.
StartLimitIntervalSec={{START_LIMIT_INTERVAL}}
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{REPO_DIR}}
# 1s polling (owner 2026-08-05); the Bybit glide and HL 429-sleep make the
# venue's rate budget the real pace, so "1" means "as fast as allowed"
ExecStart=/usr/bin/python3 -u -m gridgremlin configs/{{FLEET_CONFIG}} --snapshot logs/snapshots-{{FLEET}}.jsonl --snapshot-every 60
Restart=always
RestartSec={{RESTART_SEC}}
# v2's rule kept: under memory pressure test data dies FIRST.
OOMScoreAdjust=500
StandardOutput=append:{{REPO_DIR}}/logs/fleet-{{FLEET}}.log
StandardError=append:{{REPO_DIR}}/logs/fleet-{{FLEET}}.log

[Install]
WantedBy=default.target

[Unit]
Description=Grid Gremlin v3 market readings (D67) — public endpoints, kept in logs/market.jsonl, nothing acts on them

[Service]
Type=oneshot
WorkingDirectory={{REPO_DIR}}
EnvironmentFile={{REPO_DIR}}/.env
Nice=10
ExecStart=/usr/bin/python3 -m gridgremlin.market configs/{{FLEET_CONFIG}} {{MORE_FLEET_CONFIGS}}

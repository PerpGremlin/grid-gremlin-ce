# Local working memory — never push
CLAUDE.md

# Claude Code local settings
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# Owner working notes — never commit
docs/PerpGremlinResponse.txt

# Secrets — never commit
.env
logs/

# Rendered on the box from ops/logrotate.conf.template
ops/logrotate.conf

# Claude Code local state — never commit, any variant
.claude/

# The panel keeps a .bak beside each config it writes (§11)
configs/*.bak

# A real-money fleet's files live only in the pinned live copy, beside its
# .env, never in git (D64, F31b)
configs/*.live.json

# The launcher's saved panel key (U92) — a secret, never commit
.panel-token
